# FlipPoint's AI explanation layer is provider-agnostic: it never computes a
# number itself, only narrates results the deterministic engine already
# produced. At runtime it tries Anthropic first (if configured), falls back to
# Gemini (if configured), and finally falls back to a deterministic template
# that requires no API key at all — every path produces identical numbers.
# See src/lib/ai/explain.ts for the provider-selection logic.

# Required for the Gemini fallback provider. Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional. When set, Anthropic is tried first; Gemini (above) is used if this
# is unset or the Anthropic call fails at runtime. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
